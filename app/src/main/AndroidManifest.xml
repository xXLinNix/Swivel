<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11 and older grant Bluetooth at install time. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
        Android 12 and newer: the "Nearby devices" runtime permissions. Swivel never derives
        location from a scan, so it declares neverForLocation and needs no location permission.
        developer.android.com/develop/connectivity/bluetooth/bt-permissions
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        The Mode A link runs in a connectedDevice foreground service.
        developer.android.com/develop/background-work/services/fgs/service-types
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+: lets the service's notification, with its Disconnect button, be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <!-- The companion-device chooser is used when present; Settings is the fallback. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:name=".SwivelApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Swivel">

        <!--
            A controller connecting or disconnecting changes the keyboard and navigation
            configuration. Handling those here keeps the activity from being recreated
            mid-test every time the controller sleeps or wakes.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.modea.ModeAService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
            The MOGA SDK bridge. Old MOGA-enhanced games bind to it with this implicit action,
            as they did to PowerA's Pivot app. It must be exported for them to reach it. It
            only relays controller input, like any gamepad, and only while the Mode A link
            is up. See docs/DECISIONS.md, D-022.
        -->
        <service
            android:name=".data.bridge.MogaSdkService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.bda.controller.IControllerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
